# Maintainer: taulit
#
# Release day: replace SKIP in sha256sums with the checksum of the release tarball that
# release.yml attaches to the draft release (docs/release-checklist.md), then regenerate
# .SRCINFO with: makepkg --printsrcinfo > .SRCINFO
pkgname=sheaf
pkgver=0.1.0
pkgrel=1
pkgdesc='Fast native notes for GNOME in plain Markdown files, with a command line'
arch=(x86_64 aarch64)
url='https://github.com/taulit/sheaf'
license=(GPL-3.0-or-later)
# Found with ldd on the binary (libxkbcommon, libxkbcommon-x11, libxcb) and the names it
# loads at run time (libvulkan, libwayland-client, libwayland-egl, libEGL).
depends=(
  fontconfig
  freetype2
  gcc-libs
  glibc
  libglvnd
  libxcb
  libxkbcommon
  libxkbcommon-x11
  vulkan-driver
  vulkan-icd-loader
  wayland
)
makedepends=(cargo dbus gettext pkgconf)
optdepends=(
  'xdg-desktop-portal: theme, file dialogs, printing and the global shortcut'
  'xdg-desktop-portal-gnome: portal backend for GNOME'
  'gnome-shell: search in the overview'
)
source=("$pkgname-$pkgver.tar.gz::$url/releases/download/v$pkgver/$pkgname-$pkgver.tar.gz")
sha256sums=('SKIP')

prepare() {
  cd "$pkgname-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "$pkgname-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo build --frozen --release -p sheaf
  cargo build --frozen --profile service -p sheaf-searchd
}

check() {
  cd "$pkgname-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  # The fast suite of CI; the screenshot tests are ignored and the budgets are not run.
  cargo test --frozen --release --workspace --all-features
}

package() {
  cd "$pkgname-$pkgver"
  SHEAF_BUILD_DIR="$PWD/target/release" SHEAF_SERVICE_BUILD_DIR="$PWD/target/service" \
    SHEAF_LICENSE_NAME="$pkgname" \
    build-aux/install.sh /usr "$pkgdir"
}
