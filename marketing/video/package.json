{
  "name": "sheaf-demo-video",
  "private": true,
  "type": "module",
  "scripts": {
    "studio": "remotion studio",
    "render": "remotion render SheafDemo out/sheaf-demo.mp4 --codec=h264 --crf=18",
    "render:square": "remotion render SheafDemoSquare out/sheaf-demo-square.mp4 --codec=h264 --crf=18",
    "render:gif-source": "remotion render SheafGif out/sheaf-gif-source.mp4 --codec=h264 --crf=16",
    "gif": "pnpm render:gif-source && scripts/make-gif.sh",
    "record": "record/record.sh light",
    "og": "remotion still OgImage ../../site/public/og.png"
  },
  "dependencies": {
    "@remotion/cli": "4.0.540",
    "@remotion/google-fonts": "4.0.540",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remotion": "4.0.540"
  },
  "devDependencies": {
    "@types/react": "19.2.2",
    "typescript": "5.9.3"
  }
}
