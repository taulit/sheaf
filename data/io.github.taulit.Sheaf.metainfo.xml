  <url type="homepage">https://github.com/taulit/sheaf</url>
  <url type="bugtracker">https://github.com/taulit/sheaf/issues</url>
  <url type="vcs-browser">https://github.com/taulit/sheaf</url>
  <url type="help">https://github.com/taulit/sheaf#readme</url>

  <branding>
    <color type="primary" scheme_preference="light">#f8e45c</color>
    <color type="primary" scheme_preference="dark">#e5a50a</color>
  </branding>

  <categories>
    <category>Utility</category>
    <category>TextEditor</category>
  </categories>

  <keywords>
    <keyword>notes</keyword>
    <keyword>markdown</keyword>
    <keyword>memo</keyword>
    <keyword>checklist</keyword>
    <keyword>todo</keyword>
    <keyword>note-taking</keyword>
    <keyword xml:lang="de">notizen</keyword>
    <keyword xml:lang="de">markdown</keyword>
    <keyword xml:lang="de">memo</keyword>
    <keyword xml:lang="de">checkliste</keyword>
    <keyword xml:lang="de">aufgaben</keyword>
  </keywords>

  <content_rating type="oars-1.1"/>

  <provides>
    <binary>sheaf</binary>
    <binary>sheaf-searchd</binary>
    <mediatype>text/markdown</mediatype>
    <dbus type="user">io.github.taulit.Sheaf</dbus>
    <dbus type="user">io.github.taulit.Sheaf.SearchProvider</dbus>
  </provides>

  <requires>
    <display_length compare="ge">360</display_length>
  </requires>
  <recommends>
    <control>keyboard</control>
    <control>pointing</control>
    <control>touch</control>
  </recommends>

  <translation type="gettext">sheaf</translation>

  <releases>
    <!-- Release day: set the date to the day of the tag (docs/release-checklist.md). -->
    <release version="0.1.0" date="2026-11-18">
      <description>
        <p>First release.</p>
        <p xml:lang="de">Erste Veröffentlichung.</p>
      </description>
    </release>
  </releases>
</component>
