<?xml version="1.0" encoding="UTF-8"?>
<!--
  Translations are inline (xml:lang="de"). The repository has no gettext flow for
  XML, only for the Rust sources (scripts/update-pot.sh). Add a language here with
  the same elements when a .po file is added.

  Screenshots point at the release tag of the <release> below. Change both together
  (docs/release-checklist.md, release day).
-->
<component type="desktop-application">
  <id>io.github.taulit.Sheaf</id>
  <launchable type="desktop-id">io.github.taulit.Sheaf.desktop</launchable>

  <name>Notes</name>
  <name xml:lang="de">Notizen</name>
  <summary>Fast notes in plain Markdown files</summary>
  <summary xml:lang="de">Schnelle Notizen als Markdown-Dateien</summary>

  <developer id="io.github.taulit">
    <name>taulit</name>
  </developer>

  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>

  <description>
    <p>
      Notes keeps every note as a Markdown file in a folder you choose. It shows
      the notes as a gallery of cards, edits them in place and finds them in
      milliseconds.
    </p>
    <p xml:lang="de">
      Notizen speichert jede Notiz als Markdown-Datei in einem Ordner deiner Wahl.
      Die Notizen erscheinen als Galerie aus Karten, lassen sich an Ort und Stelle
      bearbeiten und sind in Millisekunden gefunden.
    </p>
    <ul>
      <li>Gallery and list view, folders, tags, smart folders and pinned notes</li>
      <li xml:lang="de">Galerie und Liste, Ordner, Tags, intelligente Ordner und angeheftete Notizen</li>
      <li>Search that forgives typos and knows #tags, folder:, has: and open:</li>
      <li xml:lang="de">Suche, die Tippfehler verzeiht und #Tags, ordner:, hat: und offen: kennt</li>
      <li>Editing in place, with checklists, tables, images and links between notes</li>
      <li xml:lang="de">Bearbeiten an Ort und Stelle, mit Checklisten, Tabellen, Bildern und Verweisen zwischen Notizen</li>
      <li>A Quick Note window and a global shortcut</li>
      <li xml:lang="de">Ein Schnellnotiz-Fenster und ein globales Tastenkürzel</li>
      <li>Export to Markdown and PDF, and printing</li>
      <li xml:lang="de">Export als Markdown und PDF sowie Drucken</li>
      <li>Recently Deleted keeps removed notes for 30 days</li>
      <li xml:lang="de">Zuletzt gelöscht behält entfernte Notizen 30 Tage</li>
      <li>Search in the GNOME overview</li>
      <li xml:lang="de">Suche in der GNOME-Übersicht</li>
      <li>A command line with JSON output for scripts and agents</li>
      <li xml:lang="de">Eine Befehlszeile mit JSON-Ausgabe für Skripte und Agenten</li>
    </ul>
    <p>
      The notes are ordinary files. Sync them with the tool you already use and
      open them in any other editor.
    </p>
    <p xml:lang="de">
      Die Notizen sind gewöhnliche Dateien. Sie lassen sich mit einem beliebigen
      Werkzeug synchronisieren und in jedem anderen Editor öffnen.
    </p>
  </description>

